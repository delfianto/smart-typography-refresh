{
  "name": "smart-typography-refresh",
  "version": "2.1.0",
  "description": "Obsidian plugin that converts straight quotes to curly quotes, dashes to en/em dashes, periods to ellipses, plus arrows, guillemets, comparisons and fractions. Fork by delfianto — modernized stack (Vite+, Bun, Vitest).",
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "smart-quotes",
    "typography"
  ],
  "license": "GPL-3.0-only",
  "author": "Dwi Elfianto",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "vp build --watch",
    "build": "vp build",
    "check": "vp fmt --check -c .oxfmtrc.json && vp lint -c .oxlintrc.json",
    "lint": "vp lint -c .oxlintrc.json",
    "lint:fix": "vp lint -c .oxlintrc.json --fix",
    "format": "vp fmt --write -c .oxfmtrc.json",
    "type-check": "bun x tsc --noEmit",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage"
  },
  "devDependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@lezer/common": "^1.5.3",
    "@types/node": "^26.6.3",
    "@voidzero-dev/vite-plus-core": "1.0.0",
    "builtin-modules": "^5.4.0",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  }
}
